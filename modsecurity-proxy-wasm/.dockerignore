# Git metadata
.git
.gitignore
.gitattributes

# Ephemeral build cache and artifacts (rebuilt by `make all`)
.cache/
dist/
src/generated/

# Integration tests and local dev scripts (not used by make)
test/integration/
test/regression/
test/perf/results/
test/perf/release-charts/
test/perf/.coraza/
test/perf/.noop.wasm
test/.tools/
test/unit/.build/
test/fuzz/.build/
build/docker/docker-compose.test.yml

# Docs (not needed to compile; README kept for image labels if needed)
docs/
*.md
!README.md

# Local dev / CI (not needed in builder)
.github/
.dagger/
build/shell.nix
renovate.json
.clangd

# Python bytecode
__pycache__/
*.py[cod]

# Editor / backup
*~
*.swp
Dockerfile.bak
.Dockerfile.*