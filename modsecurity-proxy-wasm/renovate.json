{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "customManagers:makefileVersions"
  ],
  "ignorePaths": [
    "!test/perf/versions.env",
    "!test/perf/requirements-charts.txt",
    "!test/perf/docker-compose.k6.yml",
    "!test/install-test-tools.sh",
    "!test/regression/ftw/docker-compose.yml",
    "!test/regression/run-ftw.sh"
  ],
  "pinDigests": true,
  "packageRules": [
    {
      "description": "Group ModSecurity tag and commit SHA",
      "matchDepNames": ["owasp-modsecurity/ModSecurity"],
      "groupName": "modsecurity"
    },
    {
      "description": "Group PCRE2 tag and commit SHA",
      "matchDepNames": ["PCRE2Project/pcre2"],
      "groupName": "pcre2"
    },
    {
      "description": "Group proxy-wasm-cpp-sdk across Makefile, shell.nix, and versions.env",
      "matchDepNames": ["proxy-wasm/proxy-wasm-cpp-sdk"],
      "groupName": "proxy-wasm-cpp-sdk"
    },
    {
      "description": "Group Envoy image across Makefile, compose, workflows, and versions.env",
      "matchDepNames": ["envoyproxy/envoy"],
      "groupName": "envoy"
    },
    {
      "description": "Group coraza-proxy-wasm release version and zip checksum",
      "matchDepNames": ["corazawaf/coraza-proxy-wasm"],
      "groupName": "coraza-proxy-wasm"
    },
    {
      "description": "Pin Debian base image digests in Dockerfiles",
      "matchManagers": ["dockerfile"],
      "matchDepNames": ["debian"],
      "pinDigests": true
    },
    {
      "description": "Git commit pins use git versioning",
      "matchManagers": ["regex"],
      "matchDepNames": ["proxy-wasm/proxy-wasm-cpp-sdk"],
      "versioning": "git"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Git commit SHA digest pins in Makefile (*_SHA)",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+?))? digest\\s*\\n[A-Z0-9_]+_SHA \\?= (?<currentDigest>[a-f0-9]{40})"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      "customType": "regex",
      "description": "proxy-wasm-cpp-sdk git commit in Makefile",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+?))?\\s*\\nPROXY_WASM_CPP_SDK_VERSION \\?= (?<currentValue>[a-f0-9]{40})"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}git{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Dependency pins in build/deps/versions.env (mirror of Makefile)",
      "managerFilePatterns": [
        "/build/deps/versions\\.env$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+?))? digest\\s*\\n[A-Z0-9_]+_SHA=(?<currentDigest>[a-f0-9]{40})",
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+?))?\\s*\\n[A-Z0-9_]+=(?<currentValue>[^\\s\\n]+)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      "customType": "regex",
      "description": "proxy-wasm-cpp-sdk git commit in shell.nix (update sha256 manually after rev bumps)",
      "managerFilePatterns": [
        "/build/shell\\.nix$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+?))?\\s*\\n\\s+rev = \"(?<currentValue>[a-f0-9]{40})\";"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}git{{/if}}"
    },
    {
      "customType": "regex",
      "description": "coraza-proxy-wasm perf comparison pins",
      "managerFilePatterns": [
        "/test/perf/versions\\.env$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+?))?\\s*\\nCORAZA_VERSION=(?<currentValue>[^\\s\\n]+)",
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+?))? digest\\s*\\nCORAZA_ZIP_SHA256=(?<currentDigest>[a-f0-9]{64})"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Unit test tool pins in test/install-test-tools.sh",
      "managerFilePatterns": [
        "/test/install-test-tools\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+?))?\\s*\\nBATS_VERSION=\"\\$\\{BATS_VERSION:-(?<currentValue>v[^\"]+)\\}\"",
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+?))?\\s*\\nGTEST_VERSION=\"\\$\\{GTEST_VERSION:-(?<currentValue>v[^\"]+)\\}\""
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Docker images in test compose files and regression scripts",
      "managerFilePatterns": [
        "/test/perf/docker-compose\\.k6\\.yml$/",
        "/test/regression/ftw/docker-compose\\.yml$/",
        "/test/regression/run-ftw\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+?))?\\s*\\n\\s+image: (?<currentValue>ghcr\\.io/[^\\s\\n]+)",
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+?))?\\s*\\n\\s+image: (?<currentValue>alpine:[^\\s\\n]+)",
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+?))?\\s*\\n\\s+image: \\$\\{K6_IMAGE:-(?<currentValue>grafana/k6:[^}]+)\\}",
        "docker\\.io/library/(?<depName>alpine):(?<currentValue>[^\\s\"]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}docker{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Hardcoded Envoy image in GitHub workflow run steps",
      "managerFilePatterns": [
        "/\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "envoyproxy/envoy:(?<currentValue>v[^\\s\"']+)"
      ],
      "depNameTemplate": "envoyproxy/envoy",
      "datasourceTemplate": "docker",
      "versioningTemplate": "loose"
    }
  ]
}