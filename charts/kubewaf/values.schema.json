{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "affinity": {
            "description": "Set affinity rules",
            "type": "object"
        },
        "args": {
            "type": "object",
            "properties": {
                "extraArgs": {
                    "description": "A list of extra arguments to add",
                    "type": "array"
                },
                "logLevel": {
                    "description": "Log Level",
                    "type": "integer"
                },
                "pprof": {
                    "description": "Enable Profiling",
                    "type": "boolean"
                }
            }
        },
        "crds": {
            "type": "object",
            "properties": {
                "annnotations": {
                    "description": "Extra Annotations for CRDs",
                    "type": "object"
                },
                "inline": {
                    "description": "Render CRDS inline (in this case use --skip-crds when installing the chart and create the config independently)",
                    "type": "boolean"
                },
                "install": {
                    "description": "Install the CustomResourceDefinitions (This also manages the lifecycle of the CRDs for update operations)",
                    "type": "boolean"
                },
                "keep": {
                    "description": "Keep the annotations if deleted",
                    "type": "boolean"
                },
                "labels": {
                    "description": "Extra Labels for CRDs",
                    "type": "object"
                }
            }
        },
        "dataplane": {
            "type": "object",
            "properties": {
                "ecds": {
                    "type": "object",
                    "properties": {
                        "port": {
                            "description": "Container / Service port for the ECDS gRPC server",
                            "type": "integer"
                        },
                        "serviceHost": {
                            "description": "DNS name Envoy uses for the ECDS cluster (defaults to release service FQDN)",
                            "type": "string"
                        }
                    }
                },
                "extensionServer": {
                    "type": "object",
                    "properties": {
                        "port": {
                            "description": "Container / Service port for the Envoy Gateway Extension Server",
                            "type": "integer"
                        }
                    }
                },
                "wasmMountPath": {
                    "description": "Mount path for shared wasm volume",
                    "type": "string"
                },
                "wasmServe": {
                    "type": "object",
                    "properties": {
                        "port": {
                            "description": "Container / Service port for multi-module wasm HTTP",
                            "type": "integer"
                        }
                    }
                },
                "wasmVolume": {
                    "description": "Optional volume mounting wasm binaries under wasmMountPath",
                    "type": "null"
                }
            }
        },
        "env": {
            "description": "Environment variables",
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "value": {
                        "type": "string"
                    }
                }
            }
        },
        "fullnameOverride": {
            "type": "string"
        },
        "global": {
            "type": "object",
            "properties": {
                "jobs": {
                    "type": "object",
                    "properties": {
                        "kubectl": {
                            "type": "object",
                            "properties": {
                                "affinity": {
                                    "description": "Set affinity rules",
                                    "type": "object"
                                },
                                "annotations": {
                                    "description": "Annotations to add to the job.",
                                    "type": "object"
                                },
                                "image": {
                                    "type": "object",
                                    "properties": {
                                        "pullPolicy": {
                                            "description": "Set the image pull policy of the helm chart job",
                                            "type": "string"
                                        },
                                        "registry": {
                                            "description": "Set the image repository of the helm chart job",
                                            "type": "string"
                                        },
                                        "repository": {
                                            "description": "Set the image repository of the helm chart job",
                                            "type": "string"
                                        },
                                        "tag": {
                                            "description": "Set the image tag of the helm chart job",
                                            "type": "string"
                                        }
                                    }
                                },
                                "labels": {
                                    "description": "Labels to add to the job.",
                                    "type": "object"
                                },
                                "nodeSelector": {
                                    "description": "Set the node selector",
                                    "type": "object"
                                },
                                "podAnnotations": {
                                    "description": "Annotations to add to the job pod",
                                    "type": "object"
                                },
                                "podLabels": {
                                    "description": "Labels to add to the job pod",
                                    "type": "object"
                                },
                                "podSecurityContext": {
                                    "description": "Security context for the job pods.",
                                    "type": "object",
                                    "properties": {
                                        "enabled": {
                                            "type": "boolean"
                                        },
                                        "seccompProfile": {
                                            "type": "object",
                                            "properties": {
                                                "type": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    }
                                },
                                "priorityClassName": {
                                    "description": "Set a pod priorityClassName",
                                    "type": "string"
                                },
                                "resources": {
                                    "description": "Job resources",
                                    "type": "object"
                                },
                                "restartPolicy": {
                                    "description": "Set the restartPolicy",
                                    "type": "string"
                                },
                                "securityContext": {
                                    "description": "Security context for the job containers.",
                                    "type": "object",
                                    "properties": {
                                        "allowPrivilegeEscalation": {
                                            "type": "boolean"
                                        },
                                        "capabilities": {
                                            "type": "object",
                                            "properties": {
                                                "drop": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string"
                                                    }
                                                }
                                            }
                                        },
                                        "enabled": {
                                            "type": "boolean"
                                        },
                                        "readOnlyRootFilesystem": {
                                            "type": "boolean"
                                        },
                                        "runAsGroup": {
                                            "type": "integer"
                                        },
                                        "runAsNonRoot": {
                                            "type": "boolean"
                                        },
                                        "runAsUser": {
                                            "type": "integer"
                                        }
                                    }
                                },
                                "tolerations": {
                                    "description": "Set list of tolerations",
                                    "type": "array"
                                },
                                "topologySpreadConstraints": {
                                    "description": "Set Topology Spread Constraints",
                                    "type": "array"
                                },
                                "ttlSecondsAfterFinished": {
                                    "description": "Sets the ttl in seconds after a finished certgen job is deleted. Set to -1 to never delete.",
                                    "type": "integer"
                                }
                            }
                        }
                    }
                }
            }
        },
        "image": {
            "type": "object",
            "properties": {
                "pullPolicy": {
                    "description": "Set the image pull policy.",
                    "type": "string"
                },
                "registry": {
                    "description": "Set the image registry",
                    "type": "string"
                },
                "repository": {
                    "description": "Set the image repository",
                    "type": "string"
                },
                "tag": {
                    "description": "Overrides the image tag whose default is the chart appVersion.",
                    "type": "string"
                }
            }
        },
        "imagePullSecrets": {
            "description": "Configuration for `imagePullSecrets` so that you can use a private images registry.",
            "type": "array"
        },
        "leaderElection": {
            "type": "object",
            "properties": {
                "enabled": {
                    "description": "Enable leader election (required when replicaCount \u003e 1)",
                    "type": "boolean"
                }
            }
        },
        "livenessProbe": {
            "description": "Configure the liveness probe using Deployment probe spec",
            "type": "object",
            "properties": {
                "httpGet": {
                    "type": "object",
                    "properties": {
                        "path": {
                            "type": "string"
                        },
                        "port": {
                            "type": "integer"
                        }
                    }
                }
            }
        },
        "monitoring": {
            "type": "object",
            "properties": {
                "enabled": {
                    "description": "Enable Monitoring of the Operator",
                    "type": "boolean"
                },
                "rules": {
                    "type": "object",
                    "properties": {
                        "annotations": {
                            "description": "Assign additional Annotations",
                            "type": "object"
                        },
                        "enabled": {
                            "description": "Enable deployment of PrometheusRules",
                            "type": "boolean"
                        },
                        "groups": {
                            "description": "Prometheus Groups for the rule. You can also enable the built-in WAF alerts below.",
                            "type": "array"
                        },
                        "labels": {
                            "description": "Assign additional labels",
                            "type": "object"
                        },
                        "namespace": {
                            "description": "Install the rules into a different Namespace, as the monitoring stack one (default: the release one)",
                            "type": "string"
                        },
                        "wafAlerts": {
                            "description": "Enable the recommended WAF data-plane + operator alerts and recording rules. When true, a solid set of alerts for modsecurity_proxy_wasm_* and kubewaf_* metrics is included.",
                            "type": "object",
                            "properties": {
                                "enabled": {
                                    "type": "boolean"
                                }
                            }
                        }
                    }
                },
                "serviceMonitor": {
                    "type": "object",
                    "properties": {
                        "annotations": {
                            "description": "Assign additional Annotations",
                            "type": "object"
                        },
                        "enabled": {
                            "description": "Enable ServiceMonitor",
                            "type": "boolean"
                        },
                        "endpoint": {
                            "type": "object",
                            "properties": {
                                "interval": {
                                    "description": "Set the scrape interval for the endpoint of the serviceMonitor",
                                    "type": "string"
                                },
                                "metricRelabelings": {
                                    "description": "Set metricRelabelings for the endpoint of the serviceMonitor",
                                    "type": "array"
                                },
                                "relabelings": {
                                    "description": "Set relabelings for the endpoint of the serviceMonitor",
                                    "type": "array"
                                },
                                "scrapeTimeout": {
                                    "description": "Set the scrape timeout for the endpoint of the serviceMonitor",
                                    "type": "string"
                                }
                            }
                        },
                        "jobLabel": {
                            "description": "Prometheus Joblabel",
                            "type": "string"
                        },
                        "labels": {
                            "description": "Assign additional labels according to Prometheus' serviceMonitorSelector matching labels",
                            "type": "object"
                        },
                        "matchLabels": {
                            "description": "Change matching labels",
                            "type": "object"
                        },
                        "namespace": {
                            "description": "Install the ServiceMonitor into a different Namespace, as the monitoring stack one (default: the release one)",
                            "type": "string"
                        },
                        "serviceAccount": {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "type": "string"
                                },
                                "namespace": {
                                    "type": "string"
                                }
                            }
                        },
                        "targetLabels": {
                            "description": "Set targetLabels for the serviceMonitor",
                            "type": "array"
                        }
                    }
                }
            }
        },
        "nameOverride": {
            "type": "string"
        },
        "nodeSelector": {
            "description": "Set the node selector",
            "type": "object"
        },
        "observability": {
            "type": "object",
            "properties": {
                "managed": {
                    "type": "object",
                    "properties": {
                        "alerts": {
                            "type": "object",
                            "properties": {
                                "enabled": {
                                    "type": "boolean"
                                }
                            }
                        },
                        "ciliumNetworkPolicy": {
                            "type": "object",
                            "properties": {
                                "enabled": {
                                    "type": "boolean"
                                },
                                "nodeCIDRs": {
                                    "type": "array"
                                }
                            }
                        },
                        "collector": {
                            "type": "object",
                            "properties": {
                                "enabled": {
                                    "type": "boolean"
                                },
                                "image": {
                                    "type": "object",
                                    "properties": {
                                        "pullPolicy": {
                                            "type": "string"
                                        },
                                        "registry": {
                                            "type": "string"
                                        },
                                        "repository": {
                                            "type": "string"
                                        },
                                        "tag": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "resources": {
                                    "type": "object",
                                    "properties": {
                                        "limits": {
                                            "type": "object",
                                            "properties": {
                                                "cpu": {
                                                    "type": "string"
                                                },
                                                "memory": {
                                                    "type": "string"
                                                }
                                            }
                                        },
                                        "requests": {
                                            "type": "object",
                                            "properties": {
                                                "cpu": {
                                                    "type": "string"
                                                },
                                                "memory": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "enabled": {
                            "description": "Enable the managed OTLP plane (Collector + metrics backend)",
                            "type": "boolean"
                        },
                        "grafana": {
                            "type": "object",
                            "properties": {
                                "enabled": {
                                    "type": "boolean"
                                }
                            }
                        },
                        "injectConfigured": {
                            "description": "Set true after applying the Envoy/Istio bootstrap fragment (cluster + sink + tags).",
                            "type": "boolean"
                        },
                        "networkPolicy": {
                            "type": "object",
                            "properties": {
                                "enabled": {
                                    "type": "boolean"
                                }
                            }
                        },
                        "otlp": {
                            "type": "object",
                            "properties": {
                                "endpoint": {
                                    "description": "Empty = in-cluster {{ fullname }}-otel-collector:4317",
                                    "type": "string"
                                },
                                "protocol": {
                                    "description": "Envoy sink / access logger protocol",
                                    "type": "string"
                                }
                            }
                        },
                        "profile": {
                            "description": "lite = metrics only; full = metrics + security traces",
                            "type": "string"
                        },
                        "prometheusRemoteWrite": {
                            "type": "object",
                            "properties": {
                                "enabled": {
                                    "description": "Prometheus remote_write (not OTLP). Use victoriaMetrics.endpoint for OTLP ingest.",
                                    "type": "boolean"
                                },
                                "endpoint": {
                                    "type": "string"
                                }
                            }
                        },
                        "traces": {
                            "type": "object",
                            "properties": {
                                "includeMatchDataDefault": {
                                    "type": "boolean"
                                },
                                "redact": {
                                    "type": "boolean"
                                },
                                "sampleDisruptive": {
                                    "type": "string"
                                },
                                "sampleNonDisruptive": {
                                    "type": "string"
                                }
                            }
                        },
                        "victoriaMetrics": {
                            "type": "object",
                            "properties": {
                                "enabled": {
                                    "description": "In-cluster single-node VM (required for lite/full unless endpoint or remote_write is set)",
                                    "type": "boolean"
                                },
                                "endpoint": {
                                    "description": "External VM / vmagent OTLP metrics ingest. Empty uses in-cluster VM when enabled.",
                                    "type": "string"
                                },
                                "image": {
                                    "type": "object",
                                    "properties": {
                                        "pullPolicy": {
                                            "type": "string"
                                        },
                                        "registry": {
                                            "type": "string"
                                        },
                                        "repository": {
                                            "type": "string"
                                        },
                                        "tag": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "resources": {
                                    "type": "object",
                                    "properties": {
                                        "limits": {
                                            "type": "object",
                                            "properties": {
                                                "cpu": {
                                                    "type": "string"
                                                },
                                                "memory": {
                                                    "type": "string"
                                                }
                                            }
                                        },
                                        "requests": {
                                            "type": "object",
                                            "properties": {
                                                "cpu": {
                                                    "type": "string"
                                                },
                                                "memory": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    }
                                },
                                "retentionPeriod": {
                                    "type": "string"
                                }
                            }
                        },
                        "victoriaTraces": {
                            "type": "object",
                            "properties": {
                                "enabled": {
                                    "type": "boolean"
                                },
                                "endpoint": {
                                    "type": "string"
                                },
                                "image": {
                                    "type": "object",
                                    "properties": {
                                        "pullPolicy": {
                                            "type": "string"
                                        },
                                        "registry": {
                                            "type": "string"
                                        },
                                        "repository": {
                                            "type": "string"
                                        },
                                        "tag": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "resources": {
                                    "type": "object",
                                    "properties": {
                                        "limits": {
                                            "type": "object",
                                            "properties": {
                                                "cpu": {
                                                    "type": "string"
                                                },
                                                "memory": {
                                                    "type": "string"
                                                }
                                            }
                                        },
                                        "requests": {
                                            "type": "object",
                                            "properties": {
                                                "cpu": {
                                                    "type": "string"
                                                },
                                                "memory": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "podAnnotations": {
            "description": "Annotations to add to pod",
            "type": "object"
        },
        "podDisruptionBudget": {
            "type": "object",
            "properties": {
                "enabled": {
                    "description": "Create a PDB",
                    "type": "boolean"
                },
                "minAvailable": {
                    "description": "Minimum available pods during voluntary disruptions",
                    "type": "integer"
                }
            }
        },
        "podLabels": {
            "description": "Annotations to add to pod",
            "type": "object"
        },
        "podSecurityContext": {
            "description": "Set the securityContext",
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "seccompProfile": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "priorityClassName": {
            "description": "Set the priority class name",
            "type": "string"
        },
        "probeTestServer": {
            "type": "object",
            "properties": {
                "auth": {
                    "type": "object",
                    "properties": {
                        "tokenSecretName": {
                            "description": "Shared bearer Secret name (empty = {{ fullname }}-probe-eval-token)",
                            "type": "string"
                        }
                    }
                },
                "concurrency": {
                    "type": "object",
                    "properties": {
                        "globalMaxInFlight": {
                            "type": "integer"
                        },
                        "maxConcurrentCompiles": {
                            "type": "integer"
                        }
                    }
                },
                "enabled": {
                    "description": "Deploy go-coraza Test HTTP Server (required only when subresourceApi.probes.enabled)",
                    "type": "boolean"
                },
                "image": {
                    "type": "object",
                    "properties": {
                        "pullPolicy": {
                            "type": "string"
                        },
                        "registry": {
                            "type": "string"
                        },
                        "repository": {
                            "type": "string"
                        },
                        "tag": {
                            "type": "string"
                        }
                    }
                },
                "networkPolicy": {
                    "description": "Create NetworkPolicy allowing only Subresource API pods",
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                },
                "podAnnotations": {
                    "type": "object"
                },
                "podLabels": {
                    "type": "object"
                },
                "replicaCount": {
                    "description": "Replica count (compile cache is per-pod if enabled later)",
                    "type": "integer"
                },
                "resources": {
                    "type": "object",
                    "properties": {
                        "limits": {
                            "type": "object",
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        },
                        "requests": {
                            "type": "object",
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "service": {
                    "type": "object",
                    "properties": {
                        "port": {
                            "type": "integer"
                        }
                    }
                }
            }
        },
        "readinessProbe": {
            "description": "Configure the readiness probe using Deployment probe spec",
            "type": "object",
            "properties": {
                "httpGet": {
                    "type": "object",
                    "properties": {
                        "path": {
                            "type": "string"
                        },
                        "port": {
                            "type": "integer"
                        }
                    }
                }
            }
        },
        "replicaCount": {
            "description": "Amount of replicas (use \u003e=2 with leader election for HA)",
            "type": "integer"
        },
        "resources": {
            "description": "Set the resource requests/limits",
            "type": "object"
        },
        "securityContext": {
            "description": "Set the securityContext for the container",
            "type": "object",
            "properties": {
                "allowPrivilegeEscalation": {
                    "type": "boolean"
                },
                "capabilities": {
                    "type": "object",
                    "properties": {
                        "drop": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "enabled": {
                    "type": "boolean"
                },
                "readOnlyRootFilesystem": {
                    "type": "boolean"
                },
                "runAsNonRoot": {
                    "type": "boolean"
                },
                "runAsUser": {
                    "type": "integer"
                }
            }
        },
        "serviceAccount": {
            "type": "object",
            "properties": {
                "annotations": {
                    "description": "Annotations to add to the service account.",
                    "type": "object"
                },
                "create": {
                    "description": "Specifies whether a service account should be created.",
                    "type": "boolean"
                },
                "name": {
                    "description": "The name of the service account to use.",
                    "type": "string"
                }
            }
        },
        "subresourceApi": {
            "description": "------------------------------------------------------------------------- Subresource API Server (aggregated subresources.kubewaf.io) + probe Test Server Disabled by default. Probes still require probeTestServer; directives/query do not.",
            "type": "object",
            "properties": {
                "concurrency": {
                    "type": "object",
                    "properties": {
                        "globalMaxInFlight": {
                            "description": "Process-wide max concurrent probes",
                            "type": "integer"
                        },
                        "perNamespace": {
                            "description": "Max in-flight probes per namespace",
                            "type": "integer"
                        }
                    }
                },
                "directives": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "description": "Register GET …/wafs/{name}/directives (no Test Server)",
                            "type": "boolean"
                        }
                    }
                },
                "enabled": {
                    "description": "Deploy the Subresource API Server + APIService",
                    "type": "boolean"
                },
                "image": {
                    "type": "object",
                    "properties": {
                        "pullPolicy": {
                            "description": "Image pull policy",
                            "type": "string"
                        },
                        "registry": {
                            "description": "Image registry (empty inherits image.registry)",
                            "type": "string"
                        },
                        "repository": {
                            "description": "Image repository for cmd/subresource-api",
                            "type": "string"
                        },
                        "tag": {
                            "description": "Image tag (empty inherits image.tag / Chart.AppVersion)",
                            "type": "string"
                        }
                    }
                },
                "networkPolicy": {
                    "description": "Create NetworkPolicy (defense-in-depth; kind often permissive)",
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                },
                "podAnnotations": {
                    "description": "Optional pod annotations",
                    "type": "object"
                },
                "podLabels": {
                    "description": "Optional pod labels",
                    "type": "object"
                },
                "probes": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "description": "Register /probes (requires probeTestServer.enabled)",
                            "type": "boolean"
                        }
                    }
                },
                "query": {
                    "type": "object",
                    "properties": {
                        "enabled": {
