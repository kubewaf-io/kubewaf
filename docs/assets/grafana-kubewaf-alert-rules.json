{
  "apiVersion": 1,
  "groups": [
    {
      "name": "kubeWAF - WAF Health",
      "folder": "kubeWAF",
      "interval": "1m",
      "rules": [
        {
          "title": "High WAF Block Rate",
          "condition": "A",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": { "from": 300, "to": 0 },
              "datasourceUid": "${DS_PROMETHEUS}",
              "model": {
                "expr": "kubewaf:waf_effectiveness:ratio > 0.15",
                "interval": "",
                "refId": "A"
              }
            }
          ],
          "noDataState": "NoData",
          "execErrState": "Error",
          "for": "5m",
          "annotations": {
            "summary": "High WAF block rate detected",
            "description": "The WAF is blocking {{ $value | humanizePercentage }} of traffic."
          },
          "labels": { "severity": "warning" }
        },
        {
          "title": "WAF Policy Not Ready",
          "condition": "A",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": { "from": 300, "to": 0 },
              "datasourceUid": "${DS_PROMETHEUS}",
              "model": {
                "expr": "kubewaf_wafenvoygateway_ready == 0",
                "refId": "A"
              }
            }
          ],
          "noDataState": "NoData",
          "execErrState": "Error",
          "for": "15m",
          "annotations": {
            "summary": "WAF is not Ready",
            "description": "Policy {{ $labels.name }} has been unhealthy."
          },
          "labels": { "severity": "critical" }
        },
        {
          "title": "No Rules Loaded in WAF Policy",
          "condition": "A",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": { "from": 300, "to": 0 },
              "datasourceUid": "${DS_PROMETHEUS}",
              "model": {
                "expr": "kubewaf_rules_loaded == 0",
                "refId": "A"
              }
            }
          ],
          "for": "10m",
          "annotations": {
            "summary": "WAF policy has zero rules",
            "description": "{{ $labels.name }} is not protecting anything."
          },
          "labels": { "severity": "warning" }
        }
      ]
    }
  ]
}